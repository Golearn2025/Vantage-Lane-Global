NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public app URL (used in invite links)
NEXT_PUBLIC_APP_URL=https://crm.vantage-lane.com

# Resend (CRM network invites + optional Auth SMTP password)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Vantage Lane Network <partnerships@vantage-lane.com>
EMAIL_REPLY_TO=partnerships@vantage-lane.com

# Server-only: Resend webhooks / admin jobs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps / Places (never commit real keys)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
